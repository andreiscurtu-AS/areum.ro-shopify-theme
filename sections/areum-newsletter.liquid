{%- style -%}
  .areum-news-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .areum-news-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .areum-news__card {
    background: linear-gradient(135deg, #f9ddbe 0%, #efb98a 100%);
    border-radius: 28px;
    padding: 36px 24px;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .areum-news__card {
      padding: 48px;
    }
  }

  .areum-news__heading {
    margin: 0;
    color: #4a2a1c;
  }

  .areum-news__text {
    font-size: 1.6rem;
    color: #86634a;
    margin: 12px 0 26px;
  }

  .areum-news__text p {
    margin: 0;
  }

  .areum-news__form {
    max-width: 460px;
    margin: 0 auto;
  }

  .areum-news__row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    align-items: stretch;
  }

  .areum-news__row input[type='email'] {
    flex: 1 1 200px;
    min-width: 0;
    background: #fff;
    border: 0 !important;
    outline: none;
    box-shadow: none !important;
    border-radius: 999px;
    padding: 15px 22px;
    font-size: 1.5rem;
    color: #4a2a1c;
    height: auto;
    line-height: 1.4;
  }

  .areum-news__row input[type='email']::placeholder {
    color: #a0714c;
  }

  .areum-news__row input[type='email']:focus {
    border: 0 !important;
    box-shadow: none !important;
    outline: 2px solid #e3ae80;
    outline-offset: 2px;
  }

  .areum-news__row .button {
    flex: none;
    white-space: nowrap;
  }

  .areum-news__message {
    margin-top: 12px;
    font-size: 1.4rem;
  }
{%- endstyle -%}

<div class="areum-news-{{ section.id }}">
  <div class="page-width">
    <div class="areum-news__card">
      {%- if section.settings.heading != blank -%}
        <h2 class="areum-news__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="areum-news__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {% form 'customer', class: 'areum-news__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="areum-news__row">
          <input
            id="AreumNewsletter--{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ section.settings.placeholder | escape }}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
            {% if form.errors %}
              aria-invalid="true"
            {% endif %}
          >
          <button type="submit" class="button" name="commit">
            {{ section.settings.button_label | escape }}
          </button>
        </div>
        {%- if form.errors -%}
          <p class="areum-news__message">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <p class="areum-news__message">{{ 'newsletter.success' | t }}</p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Areum newsletter",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "10% reducere la prima comandă ✨"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Abonează-te și prinde primele drop-uri, reduceri și restock-uri.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "adresa ta de email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "mă abonez"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Areum newsletter"
    }
  ]
}
{% endschema %}
