{%- style -%}
  .areum-trust-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .areum-trust-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .areum-trust__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media screen and (min-width: 750px) {
    .areum-trust__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .areum-trust__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .areum-trust__card {
    display: flex;
    align-items: center;
    gap: 12px;
    border-radius: 18px;
    padding: 18px 20px;
  }

  .areum-trust__emoji {
    flex: none;
    font-size: 24px;
    line-height: 1;
  }

  .areum-trust__copy {
    min-width: 0;
  }

  .areum-trust__title {
    font-family: var(--font-heading-family);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.25;
    color: #4a2e45;
    margin: 0;
  }

  .areum-trust__text {
    font-size: 1.2rem;
    line-height: 1.4;
    color: #a08a98;
    margin: 2px 0 0;
  }

  .areum-trust__text p {
    margin: 0;
  }
{%- endstyle -%}

<div class="areum-trust-{{ section.id }}">
  <div class="page-width">
    <div class="areum-trust__grid">
      {%- for block in section.blocks -%}
        <div
          class="areum-trust__card"
          style="background: {{ block.settings.background }};"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.emoji != blank -%}
            <span class="areum-trust__emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
          {%- endif -%}
          <div class="areum-trust__copy">
            {%- if block.settings.title != blank -%}
              <p class="areum-trust__title">{{ block.settings.title | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="areum-trust__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Areum trust strip",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji",
          "default": "📦"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "livrare 2–3 zile"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>prin curier, în toată țara</p>"
        },
        {
          "type": "color",
          "id": "background",
          "label": "Background",
          "default": "#FFF1F5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Areum trust strip",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "emoji": "📦",
            "title": "livrare 2–3 zile",
            "text": "<p>prin curier, în toată țara</p>",
            "background": "#FFF1F5"
          }
        },
        {
          "type": "item",
          "settings": {
            "emoji": "🇰🇷",
            "title": "100% original",
            "text": "<p>direct din Coreea</p>",
            "background": "#F3E6FF"
          }
        },
        {
          "type": "item",
          "settings": {
            "emoji": "💳",
            "title": "plata la livrare",
            "text": "<p>sau card, cum vrei tu</p>",
            "background": "#E6F7EF"
          }
        },
        {
          "type": "item",
          "settings": {
            "emoji": "🎁",
            "title": "cadou la fiecare colet",
            "text": "<p>sticker + sample surpriză</p>",
            "background": "#FFF7DE"
          }
        }
      ]
    }
  ]
}
{% endschema %}
