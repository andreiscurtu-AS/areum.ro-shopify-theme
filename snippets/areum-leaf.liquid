{%- comment -%}
  Decorative autumn leaf from the seasonal logo sheet.
  size, rotate, drift, dx, and dy are numbers. top, right, bottom, and left are CSS lengths.
{%- endcomment -%}
<span
  class="areum-leaf{% if extra_class != blank %} {{ extra_class }}{% endif %}"
  style="--leaf-size: {{ size | default: 36 }}px; --leaf-rot: {{ rotate | default: 0 }}deg; --leaf-drift: {{ drift | default: 8 }}deg; --leaf-dx: {{ dx | default: 2 }}px; --leaf-dy: {{ dy | default: -3 }}px;{% if top != blank %} top: {{ top }};{% endif %}{% if right != blank %} right: {{ right }};{% endif %}{% if bottom != blank %} bottom: {{ bottom }};{% endif %}{% if left != blank %} left: {{ left }};{% endif %}"
  aria-hidden="true"
>
  <svg viewBox="0 0 40 40" width="100%" height="100%" focusable="false">
    <path d="M20 2 C31 9 36 20 20 38 C4 20 9 9 20 2 Z" fill="{{ color | default: '#B8401F' }}"/>
    <path d="M20 6 L20 36" stroke="{{ vein | default: '#F3E6D6' }}" stroke-width="1.4" stroke-linecap="round"/>
  </svg>
</span>
